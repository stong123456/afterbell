{
  "name": "askstone",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "contracts:audit": "npm run contracts:compile && npm run contracts:lint && npm run contracts:test && node scripts/audit-contract-bytecode.mjs",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "contracts:lint": "node node_modules/solhint/solhint.js contracts/EventDecisionRegistry.sol",
    "contracts:test": "node --test --test-isolation=none tests/event-decision-registry.test.mjs",
    "preview": "vite preview",
    "test:sites": "node --test --test-isolation=none tests/sites-worker.test.mjs",
    "test:i18n": "node --test --test-isolation=none tests/i18n-locale.test.mjs",
    "test:live": "node --test --test-isolation=none tests/live-data.test.mjs",
    "test:xlayer": "node --test --test-isolation=none tests/xlayer-testnet.test.mjs",
    "xlayer:testnet:verify": "node scripts/verify-xlayer-testnet.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "ethers": "6.17.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "ganache": "7.9.2",
    "solc": "0.8.30",
    "solhint": "6.2.4"
  }
}
